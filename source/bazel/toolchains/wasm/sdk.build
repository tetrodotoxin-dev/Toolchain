load("@host_tools//:settings.bzl", "HOST_SYSTEM")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(
    "@tetro_toolchain//source/bazel:toolchains/cc.bzl",
    "wasm_runner_cc_toolchain_config",
)

package(default_visibility = ["//visibility:public"])

_SUFFIX = ".exe" if HOST_SYSTEM == "windows" else ""

_TOOLS = {
    "bin/" + executable + _SUFFIX: name
    for name, executable in {
        "ld": "wasm-ld",
        "ar": "llvm-ar",
        "cpp": "clang-cpp",
        "gcov": "llvm-cov",
        "nm": "llvm-nm",
        "objdump": "llvm-objdump",
        "strip": "llvm-strip",
    }.items()
}

_TOOLS["em++.bat" if HOST_SYSTEM == "windows" else "emscripten/em++"] = "gcc"

exports_files(
    [
        "emscripten/em++",
    ],
)

filegroup(
    name = "files",
    srcs = glob(["**"]),
)

wasm_runner_cc_toolchain_config(
    name = "config",
    node = "@emscripten_node//:node",
    sdk = ":files",
    tags = ["manual"],
    tools = _TOOLS,
)

filegroup(
    name = "runner_files",
    srcs = [
        ":files",
        "@emscripten_node//:node",
    ],
    tags = ["manual"],
)

cc_toolchain(
    name = "toolchain",
    all_files = ":runner_files",
    ar_files = ":files",
    as_files = ":files",
    compiler_files = ":runner_files",
    dwp_files = ":files",
    linker_files = ":runner_files",
    objcopy_files = ":files",
    strip_files = ":files",
    supports_param_files = 1,
    tags = ["manual"],
    toolchain_config = ":config",
    toolchain_identifier = "emscripten-validation-runner",
)
