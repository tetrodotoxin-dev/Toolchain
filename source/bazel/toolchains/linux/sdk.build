load("@tetro_toolchain//source/bazel:toolchains/linux/repository.bzl", "GCC_DIRECTORY")

filegroup(
    name = "compiler",
    srcs = glob(["usr/include/**"]) + [GCC_DIRECTORY + "/crtbegin.o"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "linker",
    srcs = glob(
        [
            "usr/lib/**",
            "lib/**",
            "lib64/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "files",
    srcs = [
        ":compiler",
        ":linker",
    ],
    visibility = ["//visibility:public"],
)
