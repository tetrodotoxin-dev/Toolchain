{
  "version": "2.0.0",
  "options": {"cwd": "${workspaceFolder}"},
  "tasks": [
    {
      "label": "[Debug] Build All",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "...",
        "--config=debug"
      ],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Build All",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "...",
        "--config=release"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Debug] Tests",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:tests", "--config=debug"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Tests",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:tests", "--config=release"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Debug] Benchmarks",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:benchmarks", "--config=debug"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Benchmarks",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:benchmarks", "--config=release"],
      "problemMatcher": "$gcc"
    }
  ]
}
