{
  "version": "2.0.0",
  "options": {"cwd": "${workspaceFolder}"},
  "tasks": [
    {
      "label": "[Debug] Build All",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "...",
        "-c", "dbg", "--symlink_prefix=.bin/"
      ],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Build All",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "...",
        "-c", "opt", "--strip=always", "--symlink_prefix=.bin/"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Format] Current File",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:format", "--", "${relativeFile}"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Format] Sources",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:format"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Debug] Tests",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:tests", "-c", "dbg"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Tests",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:tests", "-c", "opt"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Integration",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//validation/integration:integration", "-c", "opt"],
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Debug] Benchmarks",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:benchmarks", "-c", "dbg"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "[Release] Benchmarks",
      "type": "process",
      "command": "bazel",
      "args": ["run", "//:benchmarks", "-c", "opt"],
      "problemMatcher": "$gcc"
    }
  ]
}
