module(
    name = "tetro_toolchain",
    version = "0.7.1",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11.14")
use_repo(python, host_python = "python_3_11_14_host")

linux_sdk = use_repo_rule("//source/bazel:toolchains/linux/repository.bzl", "linux_sdk")

linux_sdk(name = "linux_sdk")

emscripten_sysroot = use_repo_rule(
    "//source/bazel:toolchains/wasm/repository.bzl",
    "emscripten_sysroot",
)

emscripten_sysroot(name = "emscripten_sysroot")

emscripten_sdk = use_repo_rule(
    "//source/bazel:toolchains/wasm/repository.bzl",
    "emscripten_sdk",
)

emscripten_sdk(name = "emscripten_sdk")

emscripten_node = use_repo_rule(
    "//source/bazel:toolchains/wasm/repository.bzl",
    "emscripten_node",
)

emscripten_node(name = "emscripten_node")

windows_sdk = use_repo_rule(
    "//source/bazel:toolchains/windows/repository.bzl",
    "windows_sdk",
)

windows_sdk(name = "windows_sdk")

llvm_distribution = use_repo_rule(
    "//source/bazel:toolchains/host/distribution.bzl",
    "llvm_distribution",
)

llvm_distribution(name = "llvm_distribution")

host_tools = use_repo_rule(
    "//source/bazel:toolchains/host/repository.bzl",
    "host_tools",
)

host_tools(name = "host_tools")

register_toolchains(
    "//:cc_toolchain_for_linux_x86_64",
    "//:cc_toolchain_for_wasm32",
    "//:cc_toolchain_for_wasm32_runner",
    "//:cc_toolchain_for_windows_x64",
)
