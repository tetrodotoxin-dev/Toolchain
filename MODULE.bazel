module(
    name = "tetro_toolchain",
    version = "0.3.1",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

bazel_dep(name = "rules_python", version = "1.7.0", dev_dependency = True)

linux_sdk = use_repo_rule("//source/bazel:toolchains/linux/toolchain.bzl", "linux_sdk")

linux_sdk(name = "linux_sdk")

emscripten_sysroot = use_repo_rule("//source/bazel:toolchains/wasm/toolchain.bzl", "emscripten_sysroot")

emscripten_sysroot(name = "emscripten_sysroot")

windows_sdk = use_repo_rule("//source/bazel:toolchains/windows/toolchain.bzl", "windows_sdk")

windows_sdk(name = "windows_sdk")

host_tools = use_repo_rule("//source/bazel:toolchains/host/repository.bzl", "host_tools")

host_tools(name = "host_tools")

register_toolchains("//:cc_toolchain_for_linux_x86_64", "//:cc_toolchain_for_wasm32", "//:cc_toolchain_for_windows_x64")
